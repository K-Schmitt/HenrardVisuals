# =========================================
# HenrardVisuals - Environment Variables
# =========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
#
# Generate keys with:
#   node generate-keys.cjs
# or:
#   openssl rand -base64 48

# ----------------------------------------
# PostgreSQL Database
# ----------------------------------------
POSTGRES_PASSWORD=

# ----------------------------------------
# JWT Configuration
# ----------------------------------------
# Must be at least 32 characters
# Generate: openssl rand -base64 48
JWT_SECRET=

# JWT Token Expiry (seconds)
JWT_EXPIRY=3600

# ----------------------------------------
# Supabase Keys
# ----------------------------------------
# Generate with: node generate-keys.cjs
# These are derived from JWT_SECRET and must match
ANON_KEY=
SERVICE_ROLE_KEY=

# Password for the `authenticator` role PostgREST connects as. Any strong
# random value; it is not derived from JWT_SECRET.
#   openssl rand -base64 32
# Set before the FIRST boot: migrations/006_authenticator_password.sh applies
# it while the database initialises. On an existing database, set it by hand:
#   ALTER ROLE authenticator WITH PASSWORD '<value>';
AUTHENTICATOR_PASSWORD=

# ----------------------------------------
# URLs
# ----------------------------------------
SITE_URL=http://localhost:5173
API_EXTERNAL_URL=http://localhost:8000

# ----------------------------------------
# Vite (Frontend)
# ----------------------------------------
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=

# Set to "true" only if the Storage service runs with
# ENABLE_IMAGE_TRANSFORMATION=true and an IMGPROXY_URL. When false, the app
# serves original files — correct, just larger.
VITE_IMAGE_TRANSFORM=false

# ----------------------------------------
# Authentication Settings
# ----------------------------------------
# Both default to the closed setting in docker-compose.yml when unset.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
# "true" skips address verification entirely. Leave false in production; it
# requires the SMTP settings below to be filled in.
ENABLE_EMAIL_AUTOCONFIRM=false

# Additional redirect URLs (comma-separated)
ADDITIONAL_REDIRECT_URLS=

# ----------------------------------------
# SMTP Configuration (Optional)
# ----------------------------------------
# Required for email confirmations in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=HenrardVisuals

# ----------------------------------------
# Email URL Paths
# ----------------------------------------
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
